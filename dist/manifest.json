{
  "manifest_version": 3,
  "name": "GPTCopy",
  "version": "1.1",
  "description": "Copy ChatGPT equations to Word on click",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "scripting",
    "storage",
    "declarativeContent"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
