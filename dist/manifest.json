{
    "manifest_version": 3,
    "name": "GPTCopy",
    "version": "1.0",
    "description": "Copy ChatGPT equations to Word on click",
    "permissions": [
      "clipboardWrite",
      "activeTab",
      "scripting",
      "storage"
    ],
    "action": {
       "default_popup": "popup.html"
    }
  }
